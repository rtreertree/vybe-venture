generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}


// Existing starter tables are retained so the migration does not erase their data.
model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
  posts Post[]
}

model Post {
  id        Int     @id @default(autoincrement())
  title     String
  content   String?
  published Boolean @default(false)
  author    User    @relation(fields: [authorId], references: [id])
  authorId  Int
}

model AppUser {
  token         String            @id @db.VarChar(5)
  profile       Json?
  createdAt     DateTime          @default(now())
  accounts      AppAccount[]
  conversations AppConversation[]
}

model AppAccount {
  id        String   @id @db.VarChar(128)
  userToken String   @db.VarChar(5)
  user      AppUser  @relation(fields: [userToken], references: [token], onDelete: Cascade)
  record    Json
  createdAt DateTime @default(now())

  @@index([userToken, createdAt])
}

model AppConversation {
  id        String   @id @default(uuid())
  userToken String   @db.VarChar(5)
  user      AppUser  @relation(fields: [userToken], references: [token], onDelete: Cascade)
  accountId String   @db.VarChar(128)
  topic     String   @db.VarChar(32)
  scope     String   @db.VarChar(128)
  messages  Json
  updatedAt DateTime @updatedAt

  @@unique([userToken, accountId, topic, scope])
}

model BankUser {
  userId      String   @id @db.VarChar(5)
  cashBalance Decimal  @db.Decimal(18, 2)
  currency    String   @default("USD") @db.VarChar(3)
  createdAt   DateTime @default(now())
}

model BankProduct {
  symbol               String               @id @db.VarChar(12)
  name                 String               @db.VarChar(150)
  type                 String               @db.VarChar(16)
  area                 String               @db.VarChar(64)
  description          String
  risk                 String               @db.VarChar(8)
  riskNote             String
  currency             String               @default("USD") @db.VarChar(3)
  issuer               String               @db.VarChar(150)
  region               String               @db.VarChar(64)
  currentPrice         Decimal              @db.Decimal(24, 6)
  prevClose            Decimal              @db.Decimal(24, 6)
  dividendYieldPercent Decimal              @db.Decimal(8, 2)
  size                 Decimal              @db.Decimal(24, 2)
  inceptionDate        DateTime             @db.Date
  updatedAt            DateTime             @default(now())
  holdings             BankProductHolding[]
  pricePoints          BankPricePoint[]

  @@index([area])
}

model BankProductHolding {
  id            Int         @id @default(autoincrement())
  symbol        String      @db.VarChar(12)
  product       BankProduct @relation(fields: [symbol], references: [symbol], onDelete: Cascade)
  holdingName   String      @db.VarChar(150)
  weightPercent Decimal     @db.Decimal(6, 2)

  @@index([symbol])
}

model BankPricePoint {
  id      BigInt      @id @default(autoincrement())
  symbol  String      @db.VarChar(12)
  product BankProduct @relation(fields: [symbol], references: [symbol], onDelete: Cascade)
  t       DateTime
  price   Decimal     @db.Decimal(24, 6)

  @@unique([symbol, t])
}

model BankHolding {
  id         Int      @id @default(autoincrement())
  userId     String   @db.VarChar(5)
  accountRef String   @default("") @db.VarChar(128)
  symbol     String   @db.VarChar(12)
  quantity   Decimal  @db.Decimal(24, 6)
  avgCost    Decimal  @db.Decimal(24, 6)
  updatedAt  DateTime @updatedAt

  @@unique([userId, accountRef, symbol])
  @@index([userId])
}

model BankOrder {
  orderId        String   @id @db.VarChar(32)
  userId         String   @db.VarChar(5)
  accountRef     String   @default("") @db.VarChar(128)
  symbol         String   @db.VarChar(12)
  side           String   @db.VarChar(4)
  status         String   @db.VarChar(12)
  quantity       Decimal  @db.Decimal(24, 6)
  filledPrice    Decimal  @db.Decimal(24, 6)
  total          Decimal  @db.Decimal(18, 2)
  idempotencyKey String   @db.VarChar(128)
  createdAt      DateTime @default(now())

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}
